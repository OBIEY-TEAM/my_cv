# Luka Mosala Backend - Environment Variables Configuration Example

# Django Configuration
SECRET_KEY=your_django_secret_key_here
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings

# Database Configuration (PostgreSQL / Supabase or SQLite)
SUPABASE_DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://user:password@localhost:5432/luka_mosala_db
USE_SQLITE=False

# Groq Cloud API LLM Integration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Jules API Integration
JULES_API_KEY=your_google_jules_api_key_here
JULES_API_BASE_URL=https://jules.googleapis.com/v1alpha
JULES_API_MOCK_MODE=true

# Google Drive API Integration
GDRIVE_CLIENT_ID=your_gdrive_client_id
GDRIVE_CLIENT_SECRET=your_gdrive_client_secret
GDRIVE_REFRESH_TOKEN=your_gdrive_refresh_token
