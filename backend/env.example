# Luka Mosala Backend - Environment Variables Configuration Example

SECRET_KEY=django-insecure-ai-jobapply-saas-key-2026
DEBUG=True

# Database Configuration
DATABASE_URL=postgres://user:password@localhost:5432/luka_mosala_db

# Jules API Integration
JULES_API_KEY=your_google_jules_api_key_here
JULES_API_BASE_URL=https://jules.googleapis.com/v1alpha
JULES_API_MOCK_MODE=true

# Google Drive API Integration
GDRIVE_CLIENT_ID=your_gdrive_client_id
GDRIVE_CLIENT_SECRET=your_gdrive_client_secret
GDRIVE_REFRESH_TOKEN=your_gdrive_refresh_token
